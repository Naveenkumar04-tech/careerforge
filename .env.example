# Application Environment Variables Template
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-in-production-12345
PORT=5000

# MongoDB Configuration
# For local MongoDB: mongodb://localhost:27017/student_career_db
# For MongoDB Atlas cloud: mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/student_career_db
MONGODB_URI=mongodb://localhost:27017/student_career_db
DB_NAME=student_career_db
